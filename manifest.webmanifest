{
  "name": "اختبارات ما قبل التشغيل",
  "short_name": "Precommissioning",
  "description": "نماذج اختبارات ما قبل التشغيل وسجل الأصول وسجل LV",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#1730c9",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "photos",
          "accept": [
            "image/*",
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic"
          ]
        }
      ]
    }
  }
}